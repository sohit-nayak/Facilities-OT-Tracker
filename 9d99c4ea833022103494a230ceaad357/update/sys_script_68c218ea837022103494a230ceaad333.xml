        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	var emp = current.employee;
	var dept = current.ot_request.shop_type_dept;

	// fetch employees OT hours in department
	var emplist = new GlideRecord('sys_user');
	emplist.addQuery('cost_center', dept);
	emplist.query();

	var otdata = {};

	while (emplist.next()) {
		var log = new GlideAggregate('x_1120851_ottrack_ot_log');

		log.addQuery('employee', emplist.sys_id);
		log.addAggregate('SUM', 'hours_worked');
		log.query();
		log.next();

		otdata[emplist.sys_id + ''] = parseFloat(log.getAggregate('SUM', 'hours_worked')) || 0;
	}

	var minhours = Math.min(...Object.values(otdata));

	if (otdata[emp.sys_id+''] > minhours) {
		gs.addErrorMessage('Employee has more OT than others. You must provide skip reason.');
		current.setAbortAction(true);
			}

})(current, previous);]]></script>
