        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	if (previous.request_state != 'Approved' && current.request_state == 'Approved') {

		// query all ot line requests that are approved and change state to approved
		var otline = new GlideRecord('x_1120851_ottrack_ot_request_line');
		otline.addQuery('ot_request', current.sys_id);
		otline.addQuery('skip', false);
		otline.query();

		while (otline.next()) {
			var otlog = new GlideRecord('x_1120851_ottrack_ot_log');
			otlog.initialize();
			otlog.employee = otline.employee;
			otlog.date = current.sys_created_on;
			otlog.hours_worked = otline.hours_worked;
			otlog.request_line = otline.sys_id;
			otlog.insert();
		}
	}

})(current, previous);]]></script>
