        <name>Populate Employees</name>
        <onclick/>
        <order>100</order>
        <script><![CDATA[var dept = current.shop_type_dept;
var user = new GlideRecord('sys_user');
user.addQuery('cost_center', dept);
user.query();

var empList = [];

while(user.next()) {
	var emp = user.sys_id.toString();

	var agg = new GlideAggregate('x_1120851_ottrack_ot_log');
	agg.query('employee', emp);
	agg.addAggregate('SUM', 'hours_worked');

	empList.push({employee: emp,
	cumulative: parseFloat(agg.getAggregate('SUM', 'hours_worked')) || 0 });

}

empList.sort(function(a, b) {
    return a.cumulative - b.cumulative;
  });

// create OT Line Requests for the request

for(var i=0; i <= empList.length(); i++) {
	
	var line = new GlideRecord('x_1120851_ottrack_ot_request_line');
	line.initialize();
	line.ot_request = current.sys_id;
	line.employee = empList[i].employee;
	line.cumulative_ot_hours = empList[i].cumulative;
	line.hours_worked = current.job_hours;
	line.status = 'Pending';
	line.insert();

	gs.addInfoMessage('Employee list generated and sorted by cumulative OT hours.');
}]]></script>
