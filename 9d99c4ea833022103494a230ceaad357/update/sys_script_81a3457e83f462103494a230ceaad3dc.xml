        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	var lines = new GlideRecord('x_1120851_ottrack_ot_request_line');
	lines.addQuery('ot_request', current.sys_id);
	lines.query();

	var skipped = [], included = [];

	while(lines.next()) {
		var cumulative = parseFloat(lines.cumulative_ot_hours) || 0;
		if(lines.skip) {
			if(!lines.skip_reason) {
				gs.addErrorMessage('Employee ' + lines.employee + 'has no reason for being skipped');
				current.setAbortAction(true);
				return;
			}
			skipped.push({id: lines.sys_id, hours: cumulative, name: lines.employee.name});
		} else {
			included.push({id: lines.sys_id, hours: cumulative, name: lines.employee.name});
		}
	}

})(current, previous);]]></script>
